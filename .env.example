# Banco de dados (desenvolvimento usa o container do Codespace)
DATABASE_URL=postgresql://locacao:locacao_dev@localhost:5432/locacao_dev?schema=public

# Sessão: em produção, gere um valor aleatório longo
SESSION_SECRET=troque-por-um-valor-aleatorio

# Ambiente: development | test | production
NODE_ENV=development
# Endereços do painel autorizados a chamar a API (separados por vírgula)
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

SEED_ADMIN_NAME="Admin Exemplo"
SEED_ADMIN_EMAIL=admin@exemplo.com
